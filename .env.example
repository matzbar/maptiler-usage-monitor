# Copie para .env (fora do Git) ou defina no painel da hospedagem. Nunca coloque valores reais neste arquivo.

# --- Obrigatórias ---
# Credencial de serviço do MapTiler (cloud.maptiler.com/account/credentials). Dá acesso total à conta:
# fica só no servidor, nunca no navegador nem no repositório.
MAPTILER_SERVICE_TOKEN=
# MongoDB (ex.: Atlas). Sem ela, o histórico fica só na memória e some ao reiniciar.
MONGO_URL=
DB_NAME=maptiler_monitor
# Tokens de acesso (mínimo 32 caracteres, diferentes entre si). Para gerar:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECK_TOKEN=
ADMIN_TOKEN=

# --- Opcionais (valores padrão) ---
# Cotas mensais do plano do MapTiler (Free em nov/2026: 100 mil requests e 5 mil sessions).
QUOTA_REQUESTS=100000
QUOTA_SESSIONS=5000
# Intervalo mínimo entre verificações, em minutos.
CHECK_MIN_INTERVAL_MIN=10
# Depois de quantas horas sem verificação uma leitura dispara uma nova, em segundo plano.
REFRESH_AFTER_HOURS=6
# Depois de quantas horas o consumo guardado é marcado como desatualizado (status "stale").
STALE_AFTER_HOURS=12
# Por quantos dias o histórico fica guardado.
RETENTION_DAYS=400
# Consultas ao MapTiler: tempo-limite (segundos) e tentativas.
HTTP_TIMEOUT_S=10
HTTP_ATTEMPTS=3
# Requisições por minuto por IP.
RATE_LIMIT_PER_MIN=60
# IP do visitante atrás de proxy. No Render já vem configurado (CF-Connecting-IP).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
