# Copie para .env (fora do Git) ou defina no painel da hospedagem. Nunca coloque valores reais neste arquivo.

# --- Obrigatórias ---
# Credencial de serviço do MapTiler (cloud.maptiler.com/account/credentials). Dá acesso total à conta:
# fica só no servidor, nunca no navegador nem no repositório.
MAPTILER_SERVICE_TOKEN=
# MongoDB (ex.: Atlas). Sem ela, o histórico fica só na memória e some ao reiniciar.
MONGO_URL=
DB_NAME=maptiler_monitor
# Tokens de acesso (mínimo 32 caracteres, diferentes entre si). Para gerar:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECK_TOKEN=
ADMIN_TOKEN=

# --- Alertas ---
# E-mail pelo Resend (resend.com > API Keys, permissão "Sending access"). Sem domínio próprio, o remetente é
# onboarding@resend.dev e o Resend só entrega no e-mail da sua conta do Resend.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=MapTiler Monitor <onboarding@resend.dev>
# WhatsApp pelo CallMeBot (gratuito, uso pessoal): telefone com código do país (+55...) e a chave recebida no
# WhatsApp ao ativar (www.callmebot.com/blog/free-api-whatsapp-messages/).
ALERT_WHATSAPP_PHONE=
CALLMEBOT_API_KEY=
# Faixas: porcentagem:canais (panel = só registra, para o painel; email; whatsapp). Valem para requests e
# sessions separadamente, uma vez por período.
ALERT_RULES=50:panel,70:panel,80:email,90:email+whatsapp,100:email+whatsapp
# Tentativas de envio de cada aviso (nas verificações seguintes) e falhas seguidas antes do e-mail
# "monitor sem dados".
ALERT_MAX_ATTEMPTS=3
ALERT_FAILURE_STREAK=3
# Fuso dos horários escritos nas mensagens.
ALERT_TIMEZONE=America/Sao_Paulo

# --- Opcionais (valores padrão) ---
# Cotas mensais do plano do MapTiler (Free em nov/2026: 100 mil requests e 5 mil sessions).
QUOTA_REQUESTS=100000
QUOTA_SESSIONS=5000
# Intervalo mínimo entre verificações, em minutos.
CHECK_MIN_INTERVAL_MIN=10
# Depois de quantas horas sem verificação uma leitura dispara uma nova, em segundo plano.
REFRESH_AFTER_HOURS=6
# Depois de quantas horas o consumo guardado é marcado como desatualizado (status "stale").
STALE_AFTER_HOURS=12
# Por quantos dias o histórico fica guardado.
RETENTION_DAYS=400
# Consultas ao MapTiler: tempo-limite (segundos) e tentativas.
HTTP_TIMEOUT_S=10
HTTP_ATTEMPTS=3
# Requisições por minuto por IP.
RATE_LIMIT_PER_MIN=60
# IP do visitante atrás de proxy. No Render já vem configurado (CF-Connecting-IP).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
